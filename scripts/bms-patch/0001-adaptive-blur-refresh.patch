+// True when opaque window actors cover every sample point of the surface's
+// region: the surface's pixels cannot reach the screen, so freezing it is
+// visually identical. Universal geometric rule, no per-component logic.
+function fullyCoveredByOpaqueWindows(actor) {
+    let [ax, ay] = actor.get_transformed_position();
+    let [w, h] = actor.get_transformed_size();
+    if (!(w > 0 && h > 0) || !Number.isFinite(ax) || !Number.isFinite(ay))
+        return false;
+    ax = Math.round(ax); ay = Math.round(ay);
+    w = Math.round(w); h = Math.round(h);
+    const wins = global.get_window_actors().map(wa => {
+        const m = wa.meta_window;
+        if (!m || m.minimized)
+            return null;
+        const r = m.get_frame_rect();
+        return {r, op: wa.opacity, map: m.get_window_type() === 0};
+    }).filter(x => x && x.map && x.op >= 250);
+    if (!wins.length)
+        return false;
+    const GRID = 8;
+    let covered = 0, total = 0;
+    for (let gy = 0; gy < GRID; gy++) {
+        for (let gx = 0; gx < GRID; gx++) {
+            total++;
+            const px = ax + (gx + 0.5) * w / GRID;
+            const py = ay + (gy + 0.5) * h / GRID;
+            if (wins.some(win =>
+                px >= win.r.x && px < win.r.x + win.r.width &&
+                py >= win.r.y && py < win.r.y + win.r.height))
+                covered++;
+        }
+    }
+    return covered >= total * 0.98;
+}
