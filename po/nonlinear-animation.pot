#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:18
msgid "Easing curve (legacy)"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:19
msgid ""
"Legacy curve key from v1-v5. Still read once for migration to selected-"
"curve; otherwise unused."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:23
msgid "Settings schema version"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:24
msgid ""
"Bumped automatically after the one-time migration from the legacy mode key."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:28
msgid "Selected curve"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:29
msgid ""
"Id of the active curve: a built-in preset (preset:…) or a user curve "
"(user:…)."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:33
msgid "User curves"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:34
msgid "User-created and imported curves, one JSON object per entry."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:39
msgid ""
"Replace GNOME's easing curves with the selected curve. Off: GNOME's own "
"curves play untouched; interruption continuity still applies."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:44
msgid "Interruption momentum"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:45
msgid ""
"Same-direction inertia: how much velocity carries over when the new "
"animation continues the old direction (e.g. flipping two app-grid pages "
"quickly). 0 = GNOME-like re-acceleration, 1 = balanced, 2 = exaggerated."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:51
msgid ""
"Reversal inertia: the decelerate-and-rebound feel when an animation is "
"interrupted into the opposite direction (minimize right after starting a "
"restore). 0 = hard reversal, 1 = balanced bounce, 2 = deep elastic "
"compression."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:55
msgid "Reversal buffering enabled"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:56
msgid ""
"Master switch for the reversal bounce, independent of the same-direction "
"momentum. Off = interrupted reversals change direction immediately (native "
"behavior)."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:60
msgid "Ease workspace switching"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:61
msgid ""
"Apply the curve and duration to workspace switch animations. Turn off if "
"secondary monitors flicker during switches on multi-monitor fractional-scale "
"setups."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:66
msgid ""
"When an animation is interrupted (e.g. flipping two app-grid pages quickly), "
"carry the current velocity into the new animation instead of re-accelerating "
"from standstill, using a velocity-matched spring."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:74
msgid "Spring solver"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:75
msgid ""
"How spring curves are evaluated. analytic (default): closed-form solution, a "
"few math calls per frame. numeric: Ultra mode, per-frame physics integration "
"for maximum fidelity at a slightly higher CPU cost."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:81
msgid ""
"Only animations at or above this duration get the easing curve. Lower = more "
"things eased (hovers ~100ms); higher = fewer."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:86
msgid "Duration scale"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:87
msgid ""
"Multiplier for the duration of eased animations. 1.0 = GNOME's default "
"(quick); 1.8 ≈ macOS; 2.5 = slow/luxurious."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:93
msgid ""
"Duration multiplier for animations during/after a touchpad gesture "
"(workspace switch, app-grid paging). The easing curve is kept at GNOME's "
"velocity-matched EASE_OUT_CUBIC so there's no jolt on release; this only "
"stretches the duration so the deceleration reads more. 1.0 = gestures fully "
"native."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:98
msgid "Touchpad gesture grace (ms)"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:99
msgid ""
"Window after a touchpad gesture (3-finger swipe/pinch) during which "
"animations play at GNOME's native speed. Touchpad-driven overview/workspace "
"opens already track your finger, so their wrap-up shouldn't be slowed. Set 0 "
"to disable the exception (ease everything, including gestures)."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:103
msgid "Enabled (legacy)"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:104
msgid ""
"Legacy key from earlier versions, no longer read. Pause the extension from "
"the Extensions manager instead."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:111
msgid "Continuity engine (legacy)"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:112
msgid ""
"Legacy key from the curve-library versions. The experimental spring "
"simulation engine was removed in v10; installs still on spring are moved "
"back to bridge at startup."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:117
msgid ""
"Route a close requested while the overview is still animating through the "
"gesture channel, so the drawer reverses immediately instead of finishing its "
"opening first. Turn off if overview open/close misbehaves."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:121
msgid "Ease magic-lamp minimize/unminimize"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:122
msgid ""
"If compiz-alike-magic-lamp-effect is installed, curve its minimize/"
"unminimize timeline with EASE_OUT_CUBIC so the window decelerates into the "
"dock instead of stopping dead. No-op if magic-lamp isn't installed."
msgstr ""
