#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:18
msgid "Easing curve (legacy)"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:19
msgid ""
"Legacy curve key from v1–v5. Still read once for migration to selected-"
"curve; otherwise unused."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:23
msgid "Settings schema version"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:24
msgid ""
"Bumped automatically after the one-time migration from the legacy mode key."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:28
msgid "Selected curve"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:29
msgid ""
"Id of the active curve: a built-in preset (preset:…) or a user curve "
"(user:…)."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:33
msgid "User curves"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:34
msgid "User-created and imported curves, one JSON object per entry."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:39
msgid ""
"When an animation is interrupted (e.g. flipping two app-grid pages quickly), "
"carry the current velocity into the new animation instead of re-accelerating "
"from standstill, using a velocity-matched spring."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:47
msgid "Spring solver"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:48
msgid ""
"How spring curves are evaluated. analytic (default): closed-form solution, a "
"few math calls per frame. numeric: Ultra mode, per-frame physics integration "
"for maximum fidelity at a slightly higher CPU cost."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:54
msgid ""
"Only animations at or above this duration get the easing curve. Lower = more "
"things eased (hovers ~100ms); higher = fewer."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:59
msgid "Duration scale"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:60
msgid ""
"Multiplier for the duration of eased animations. 1.0 = GNOME's default "
"(quick); 1.8 ≈ macOS; 2.5 = slow/luxurious."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:66
msgid ""
"Duration multiplier for animations during/after a touchpad gesture "
"(workspace switch, app-grid paging). The easing curve is kept at GNOME's "
"velocity-matched EASE_OUT_CUBIC so there's no jolt on release; this only "
"stretches the duration so the deceleration reads more. 1.0 = gestures fully "
"native."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:71
msgid "Touchpad gesture grace (ms)"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:72
msgid ""
"Window after a touchpad gesture (3-finger swipe/pinch) during which "
"animations play at GNOME's native speed. Touchpad-driven overview/workspace "
"opens already track your finger, so their wrap-up shouldn't be slowed. Set 0 "
"to disable the exception (ease everything, including gestures)."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:77
msgid "Master switch (A/B without disabling the whole extension)."
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:81
msgid "Ease magic-lamp minimize/unminimize"
msgstr ""

#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:82
msgid ""
"If compiz-alike-magic-lamp-effect is installed, curve its minimize/"
"unminimize timeline with EASE_OUT_CUBIC so the window decelerates into the "
"dock instead of stopping dead. No-op if magic-lamp isn't installed."
msgstr ""
