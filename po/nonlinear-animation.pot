#: prefs.js:60
#: schemas/org.gnome.shell.extensions.nonlinear-animation.gschema.xml:38
msgid "Apply custom curves"
msgstr ""

#: prefs.js:61
msgid ""
"Off: GNOME own curves play untouched; interruption continuity still applies. "
"The gallery is disabled while off."
msgstr ""

#: prefs.js:92
msgid "Speed"
msgstr ""

#: prefs.js:93
msgid ""
"How long eased animations take to play. Dragging right slows them down: 1.0 "
"= GNOME default, 1.8 ≈ macOS."
msgstr ""

